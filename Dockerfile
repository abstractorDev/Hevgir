# استفاده از نسخه سبک لینوکس و نود.جی‌اس
FROM node:20-alpine

# تنظیم پوشه کاری داخل کانتینر
WORKDIR /app

# کپی کردن فایل‌های وابستگی برای نصب
COPY package.json ./

# نصب پکیج‌ها (اجرای npm install)
RUN npm install

# کپی کردن کل کدهای پروژه (به جز مواردی که در dockerignore هستند)
COPY . .

# مشخص کردن پورتی که وب‌سرور مصنوعی ما روی آن گوش می‌دهد
EXPOSE 3000

# دستوری که کانتینر پس از بالا آمدن اجرا می‌کند
CMD ["npm", "start"]